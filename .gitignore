# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Build files
build/
.ninja_*
build.ninja

# Generated configs
compile_commands.json

# The January build and the Xbox SDK (tools/xdk_headers.py reads the
# build's PDB); never commit
*.exe
*.pdb
/xbox/
!source/**/xbox/

# Console SDKs and what they build: libraries, objects and executables
# come from the user's own SDK or toolchain, and console packages may
# hold the user's maps (never commit)
*.lib
*.obj
*.xbe
*.xex
*.rpx
*.wuhb
*.nro
*.nsp
*.pkg
*.self

# Disc images and the game's own files (never commit)
*.iso
*.xiso
*.map
*.bik
*.xmv

# Locally extracted proprietary game data (never commit)
/assets
original/

# CI build outputs (tools/ci_build.py)
dist/


/.easy_build.json
/out/
# the game's log, when a run writes it at the top of the tree
/debug.txt
